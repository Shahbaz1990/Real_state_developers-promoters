# Block PHP execution inside the uploads directory.
# These directories must only ever store static images.
Options -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .cgi .pl .py

<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|phar|pl|py|cgi)$">
    Require all denied
</FilesMatch>
